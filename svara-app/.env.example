# Which conversion backend the API routes call.
#   elevenlabs (default) -> paid ElevenLabs Dubbing API, needs ELEVENLABS_API_KEY.
#   opensource            -> free, self-hosted pipeline in ../svara-backend
#                            (Demucs + faster-whisper + Argos Translate + XTTS-v2).
CONVERSION_BACKEND=elevenlabs

# --- elevenlabs backend ---
# Get a key at https://elevenlabs.io (Dubbing API access on your plan).
# Without this set, the app runs in mock mode: the full upload -> convert -> play
# flow works end-to-end, but the "converted" audio returned is the original file
# unchanged, clearly labeled as a mock result.
ELEVENLABS_API_KEY=

# --- opensource backend ---
# Where svara-backend's FastAPI server is running (see svara-backend/README.md).
OPEN_SOURCE_BACKEND_URL=http://localhost:8000
